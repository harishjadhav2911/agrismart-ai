# Required for the AI Assistant and Crop Disease Analysis features.
# You can obtain this key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_google_gemini_api_key_here

# AgriSmart AI — CropRelief Persistent Database Configuration (Supabase PostgreSQL)
# Recommended: Supabase Connection Pooler (Session/Transaction mode on port 6543 or 5432)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres
# DATABASE_SSL=true (default: true for cloud providers)

# AgriSmart AI — Automated Government GR Scraper & Cron Security Secrets
# Kept strictly server-side. Used to authenticate /api/crop-relief/refresh
RELIEF_ADMIN_SECRET=your_custom_admin_refresh_secret_min_32_chars
CRON_SECRET=your_vercel_cron_secret_min_32_chars
ADMIN_SECRET=your_custom_admin_dashboard_secret_min_32_chars

# (Optional) If you integrate Firebase Authentication later, add these keys:
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=

